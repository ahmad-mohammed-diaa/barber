{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit(*.ts,*.tsx)",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsc --noEmit 2>&1 | head -20"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit(*.ts,*.tsx,*.js,*.jsx)",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint $CLAUDE_TOOL_INPUT_PATH --max-warnings=0 2>&1 | head -20"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cp ~/.claude/projects/$(basename $CLAUDE_PROJECT_DIR)-session.jsonl ~/.claude/backups/session-$(date +%s).jsonl 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
